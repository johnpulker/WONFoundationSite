# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PayPal Configuration
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_ID=your_paypal_client_id
# Note: PAYPAL_CLIENT_ID and NEXT_PUBLIC_PAYPAL_CLIENT_ID should be the same value
# The NEXT_PUBLIC_ version is for client-side, the other is for server-side
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# For production, use: https://api-m.paypal.com

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=events@mydomain.com
ORGANIZER_EMAIL=your-email@gmail.com
ADMIN_EMAIL=administrator@wonfoundation.net

# Site URL (for API calls in server components)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production, use your actual domain: https://yourdomain.com

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Get these from: https://dash.cloudflare.com/?to=/:account/turnstile
